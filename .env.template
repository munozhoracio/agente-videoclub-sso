APP_VERSION=1.0.0
STAGE=dev
PORT=8085

# OpenAI Credentials
OPENAI_API_KEY=tu-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Servidor MCP de VideoClub (Spring Boot Resource Server)
# En Docker con name: videoclub, el backend en el host se alcanza via host.docker.internal
# Un endpoint MCP por servicio desde que el backend se separo en dos.
CATALOG_MCP_URL=http://host.docker.internal:8081/mcp
MEMBERSHIP_MCP_URL=http://host.docker.internal:8082/mcp

# Autenticación Keycloak
# KEYCLOAK_ISSUER_URI debe coincidir con el claim 'iss' del token JWT emitido por Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:9090/realms/videoclub
# Para descargar certs y tokens desde la red interna de Docker 'videoclub_default':
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/videoclub/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/videoclub/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=videoclub-backend
KEYCLOAK_CLIENT_SECRET=dstNSsANvqlaGfZCJa1mcYzP1EBAYP4N
