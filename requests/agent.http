# VideoClub AI Agent - MCP Testing Suite
# Compatible con VS Code REST Client (Antigravity IDE) e IntelliJ HTTP Client

@host = localhost
@keycloak_port = 9091
@agent_port = 8085
@gateway_port = 9500

@base_url = http://{{host}}:{{agent_port}}
@gateway_url = http://{{host}}:{{gateway_port}}

@admin_token = {{login_admin.response.body.access_token}}
@cliente_token = {{login_cliente.response.body.access_token}}

# ====================================================================
# 1. Autenticación Keycloak (:9091)
# ====================================================================

###
# @name login_admin
# Obtiene token JWT para usuarioadmin (Rol Administrador con acceso a socios y películas)
POST http://{{host}}:{{keycloak_port}}/realms/videoclub/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=videoclub-frontend&username=usuarioadmin&password=usuarioadmin&grant_type=password&scope=openid

###
# @name login_cliente
# Obtiene token JWT para usuariocliente (Rol Cliente - Solo lectura de películas, sin acceso a socios)
POST http://{{host}}:{{keycloak_port}}/realms/videoclub/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=videoclub-frontend&username=usuariocliente&password=usuariocliente&grant_type=password&scope=openid

# ====================================================================
# 2. Diagnóstico del Agente (:8085)
# ====================================================================

###
# @name agent_health_anonymous
# Health Check del Microservicio (PermitAll - Acceso anónimo permitido)
GET {{base_url}}/api/agent/health
Accept: application/json

###
# @name agent_list_tools
# Descubrimiento de Herramientas MCP registradas (Requiere JWT autenticado)
GET {{base_url}}/api/agent/tools
Authorization: Bearer {{admin_token}}
Accept: application/json

# ====================================================================
# 3. Pruebas de Seguridad y Token Relay (Directo :8085)
# ====================================================================

###
# @name agent_chat_unauthenticated_fails
# Intento de chat anónimo sin token - Debe fallar con HTTP 401 Unauthorized
POST {{base_url}}/api/agent/chat
Content-Type: application/json

{
  "prompt": "¿Qué películas tienen disponibles?"
}

###
# @name agent_chat_admin_list_movies
# Chat con token de Administrador (Roberto Perez) - Consulta de películas
POST {{base_url}}/api/agent/chat
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "prompt": "¿Qué películas tienen disponibles actualmente en el catálogo del VideoClub?"
}

###
# @name agent_chat_admin_list_socios_allowed
# Chat con token de Administrador - Acceso a socios permitido (rol socio-permission-read)
POST {{base_url}}/api/agent/chat
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "prompt": "¿Quiénes son los socios registrados en el videoclub y cuál es su estado?"
}

###
# @name agent_chat_cliente_list_movies_allowed
# Chat con token de Cliente (Jose Lopez) - Consulta de películas permitida
POST {{base_url}}/api/agent/chat
Authorization: Bearer {{cliente_token}}
Content-Type: application/json

{
  "prompt": "Hola, ¿me podrías decir qué películas hay disponibles?"
}

###
# @name agent_chat_cliente_list_socios_denied
# Chat con token de Cliente - Consulta de socios rechazada por @PreAuthorize downstream
POST {{base_url}}/api/agent/chat
Authorization: Bearer {{cliente_token}}
Content-Type: application/json

{
  "prompt": "¿Me pasás la lista de socios del videoclub?"
}

###
# ====================================================================
# 4. Pruebas a través de Spring Cloud Gateway (:9500)
# ====================================================================
# @name gateway_agent_health
# Health Check del Agente a través del Gateway (:9500/api/agent/health)
GET {{gateway_url}}/api/agent/health
Accept: application/json

###
# @name gateway_agent_chat_with_token
# Chat con Agente a través del Gateway con Token Relay del usuario
POST {{gateway_url}}/api/agent/chat
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "prompt": "¿Qué películas tienen disponibles en el videoclub?"
}
