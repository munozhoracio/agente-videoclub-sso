APP_VERSION=1.0.0
STAGE=prod
PORT=8085

# OpenAI Credentials
OPENAI_API_KEY=tu-openai-api-key-produccion
OPENAI_MODEL=gpt-4o-mini

# Servidor MCP de VideoClub
VIDEOCLUB_MCP_URL=http://host.docker.internal:8080/mcp

# Autenticación Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:9091/realms/videoclub
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/videoclub/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/videoclub/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=videoclub-backend
KEYCLOAK_CLIENT_SECRET=tu-keycloak-client-secret-produccion

# --- Variante de imagen nativa (GraalVM) ---
# Seleccionan la etapa del Dockerfile y el sufijo del tag. Ver docker-compose.prod.yml.
BUILD_TARGET=native-runtime
IMAGE_SUFFIX=-native
