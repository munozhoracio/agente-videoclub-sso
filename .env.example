KEYCLOAK_JWK_SET_URI=http://localhost:9090/realms/videoclub/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://localhost:9090/realms/videoclub/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=videoclub-backend
