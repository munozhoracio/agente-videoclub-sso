# Puerto del agente
PORT=8085

# Credenciales OpenAI
OPENAI_API_KEY=tu-api-key-aqui
OPENAI_MODEL=gpt-4o-mini

# URL del servidor MCP de VideoClub (Spring Boot Resource Server)
# Un endpoint MCP por servicio desde que el backend se separo en dos.
CATALOG_MCP_URL=http://localhost:8081/mcp
MEMBERSHIP_MCP_URL=http://localhost:8082/mcp

# Autenticación Keycloak para Startup/Service Account (Client Credentials Grant)
